load("//tools:cpplint.bzl", "cpplint")
load("//tools:rules_cc.bzl", "myapp_cc_binary", "myapp_cc_library")
load("//tools:variables.bzl", "MYAPP_DESCRIPTION", "MYAPP_NAME", "MYAPP_VERSION")

genrule(
    name = "generate_version_header",
    srcs = [":version.h.in"],
    outs = ["version.h"],
    cmd = "$(location //tools:generate_version_header) '$(location :version.h.in)' %s %s '%s' > $@" % (MYAPP_NAME, MYAPP_VERSION, MYAPP_DESCRIPTION),
    cmd_ps = "& '$(location //tools:generate_version_header.ps1)' '$(location :version.h.in)' '%s' '%s' '%s' > $@" % (MYAPP_NAME, MYAPP_VERSION, MYAPP_DESCRIPTION),
    stamp = True,
    tools = [
        "//tools:generate_version_header",
        "//tools:generate_version_header.ps1",
    ],
)

myapp_cc_library(
    name = "version",
    hdrs = [":generate_version_header"],
    visibility = ["//visibility:public"],
)

myapp_cc_binary(
    name = "myapp",
    srcs = ["main.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":version",
        "//myapp/util:calculator",
        "@fmt",
    ],
)

cpplint()
